# Для локального запуска оставьте AMVERA пустой.
# На Amvera установите AMVERA=1 и заполните PostgreSQL-переменные.
AMVERA=1

# Flask: задайте длинные случайные значения в панели переменных окружения.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_SECRET_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
ADMIN_PATH=/control-panel

# PostgreSQL Amvera
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name

# Онлайн-бронирование: локально можно включить, на Amvera по умолчанию выключено.
# Для повторного включения на Amvera установите ENABLE_BOOKING=true.
ENABLE_BOOKING=false
